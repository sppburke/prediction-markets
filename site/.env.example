# Copy to .env.local and fill in. These are the PUBLIC anon/publishable credentials used only for
# the shared Paper views; account/live paths use the server-only service role below.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# ── WS3 admin auth + write path (#398) ───────────────────────────────────────
# Server-only secrets. In production these live in .env.production (chmod 600) on the VPS,
# NEVER committed and NEVER NEXT_PUBLIC_ (the service-role key bypasses RLS).
#
# AUTH_SECRET: `openssl rand -base64 32`. Required at runtime (build is green without it).
AUTH_SECRET=<random 32-byte base64>
# Google OAuth client (GCP console → Credentials → OAuth client, type "Web application").
# redirect URI: https://<your-domain>/api/auth/callback/google ; origin: https://<your-domain>
AUTH_GOOGLE_CLIENT_ID=<google oauth client id>
AUTH_GOOGLE_CLIENT_SECRET=<google oauth client secret>
# Public origin of the deployed site (next-auth callbacks). Behind an nginx TLS proxy on a custom
# port, set this to the full https origin, e.g. https://<sub>.duckdns.org:3000 (trustHost also on).
AUTH_URL=https://<your-domain>
# Supabase service-role (secret) key — server-only; used for viewer binding, account/live reads,
# and admin RPCs. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role secret key>
# ONE service-scoped X25519 age recipient (starts with age1). The matching private identity is
# held by the execution service and must never be installed on the site host.
PE_AGE_RECIPIENT=age1...

# Copy to .env.local and fill in. These are the PUBLIC anon/publishable
# credentials — the site reads Supabase under read-only RLS only. NEVER put the
# service-role secret key here (that key bypasses RLS and is pe-service's alone).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

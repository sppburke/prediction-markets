# Copy to .env.local and fill in. These are the PUBLIC anon/publishable
# credentials — the site reads Supabase under read-only RLS only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# ── WS3 admin auth + write path (#398) ───────────────────────────────────────
# Server-only secrets. In production these live in .env.production (chmod 600) on the VPS,
# NEVER committed and NEVER NEXT_PUBLIC_ (the service-role key bypasses RLS).
#
# AUTH_SECRET: `openssl rand -base64 32`. Required at runtime (build is green without it).
AUTH_SECRET=<random 32-byte base64>
# Password login (Credentials provider) — works on a bare IP, where Google OAuth can't (Google
# forbids IP redirect URIs). A correct value grants the single allowed identity. Use a strong
# value; note it travels in cleartext over plain HTTP, so prefer a domain + HTTPS for real privacy.
SITE_PASSWORD=<dashboard login password>
# Google OAuth client (GCP console → Credentials → OAuth client, type "Web application").
# Only usable on a domain (https); redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=<google oauth client id>
AUTH_GOOGLE_CLIENT_SECRET=<google oauth client secret>
# Public origin of the deployed site (used by next-auth for callbacks). With trustHost the origin
# is derived from the request Host, so this is optional for bare-IP access.
AUTH_URL=https://<your-domain>
# Supabase service-role (secret) key — server-only; used solely by /api/config to write
# service_config. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role secret key>

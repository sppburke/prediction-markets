[Unit]
Description=pe-bootstrap incremental Dune wallet discovery (issue #166)
Documentation=https://github.com/sppburke/prediction-markets/issues/166
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# WorkingDirectory required so relative paths in .env (PE_BOOTSTRAP_CACHE_PATH etc.) resolve.
# Update to match the repo root on the host.
WorkingDirectory=%h/prediction-markets
EnvironmentFile=%h/prediction-markets/.env
# Replace with the pe-bootstrap binary path post-`cargo install --path crates/bootstrap`.
ExecStart=%h/.cargo/bin/pe-bootstrap discovery
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pe-bootstrap-discovery

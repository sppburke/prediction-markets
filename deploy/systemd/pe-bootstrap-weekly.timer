[Unit]
Description=Run pe-bootstrap weekly funder refresh
Documentation=https://github.com/sppburke/prediction-markets/issues/166

[Timer]
# Sundays at 12:00 local. Staggered after both discovery (02:00) and backfill (06:00).
OnCalendar=Sun *-*-* 12:00:00
Persistent=true
Unit=pe-bootstrap-weekly.service

[Install]
WantedBy=timers.target

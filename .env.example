# .env.example — sanitised environment variable template for pe-bootstrap, pe-backtest,
# and pe-service (the live copy-trader).
#
# IMPORTANT: If this repo was previously cloned with a real .env committed, rotate every
# credential listed here before using them. Git history retains committed secrets; rotation
# is the only remediation (adding to .gitignore does not remove history).
#
# Copy this file: cp .env.example .env  then fill in real values.
# Required fields are marked [required]; the rest have defaults or are optional features.

# ── Polygon RPC ─────────────────────────────────────────────────────────────────────────
# Active provider — point at whichever account has remaining CU.
PE_POLYGON_HTTP_URL=<your-polygon-http-rpc-url>          # [required] pe-bootstrap funder graph
PE_POLYGON_WS_URL=<your-polygon-ws-rpc-url>              # [required] pe-bootstrap funder graph

# Optional: named alternates for quick CU-rotation without changing the active line.
# Rename _APEXURE / _SPPBURKE to match your own account names.
PE_POLYGON_HTTP_URL_APEXURE=<your-polygon-http-rpc-url-account1>
PE_POLYGON_WS_URL_APEXURE=<your-polygon-ws-rpc-url-account1>
PE_POLYGON_HTTP_URL_SPPBURKE=<your-polygon-http-rpc-url-account2>
PE_POLYGON_WS_URL_SPPBURKE=<your-polygon-ws-rpc-url-account2>

# ── Etherscan V2 (Polygon chain ID 137) ─────────────────────────────────────────────────
PE_ETHERSCAN_API_KEY=<your-etherscan-api-key>            # [required] pe-bootstrap funder graph

# ── Polymarket credentials (live trading only) ──────────────────────────────────────────
# Not required for backtest-only runs.
PE_POLYMARKET_PRIVATE_KEY=<your-eoa-private-key>
PE_POLYMARKET_CLOB_API_KEY=<your-clob-api-key>
PE_POLYMARKET_CLOB_API_SECRET=<your-clob-api-secret>
PE_POLYMARKET_CLOB_API_PASSPHRASE=<your-clob-api-passphrase>
PE_POLYMARKET_FUNDER_ADDRESS=<your-funder-address>
PE_EOA=<your-eoa-address>

# ── pe-service live wallet source (Supabase, issue #339) ────────────────────────────────
# The live copy-trader reads its wallet set from Supabase (`latest_ranking`) when
# `supabase_url` is set (TOML or PE_SUPABASE_URL); empty => falls back to
# `seed_watchlist_path`. pe-service also uses the Polymarket credentials above in live mode.
# These hold the SAME values as the SUPABASE_* keys the ranking-push scripts use — note the
# PE_ prefix pe-service requires (figment reads only PE_*-prefixed keys).
PE_SUPABASE_URL=<your-supabase-project-url>              # e.g. https://<ref>.supabase.co
PE_SUPABASE_ANON_KEY=<your-supabase-anon-publishable-key>
PE_SUPABASE_SECRET_KEY=<your-supabase-service-role-key>

# ── Bootstrap output paths ──────────────────────────────────────────────────────────────
PE_BOOTSTRAP_OUTPUT=<path-to-bootstrap-sqlite-db>        # [required] e.g. /data/bootstrap.db
PE_BOOTSTRAP_CACHE_PATH=<path-to-wallet-cache-sqlite>    # [required] e.g. /data/wallet_cache.db
PE_BOOTSTRAP_WALLET_SET_PATH=<path-to-wallet-set-json>   # [required] e.g. /data/wallet_set.json

# ── Bootstrap feature flags ─────────────────────────────────────────────────────────────
PE_BOOTSTRAP_FETCH_RESOLUTIONS=1                         # set 1 to populate market_resolutions
PE_BOOTSTRAP_FETCH_FUNDER_GRAPH=1                        # set 1 to populate funder_edges (~2h)
PE_BOOTSTRAP_SKIP_TRADE_FETCH=0                          # set 1 only when cache is known current

# ── Bootstrap quality thresholds (optional — defaults in _GLOSSARY.md) ──────────────────
# PE_BOOTSTRAP_MIN_CLOSED_TRADES=20
# PE_BOOTSTRAP_MIN_WIN_RATE_PCT=0.50
# PE_BOOTSTRAP_AUDIT_WINDOW_DAYS=180
# PE_BOOTSTRAP_POST_FILTER_ACTIVE_DAYS=30
# PE_BOOTSTRAP_POST_FILTER_MAX_AVG_HOURS=72
# PE_BOOTSTRAP_POLYMARKET_CONCURRENCY=4
# PE_WALLET_FROM_BLOCK=0
# PE_WALLET_TO_BLOCK=99999999
# PE_SEED_AS_OF_DATES=

# ── Backtest output ─────────────────────────────────────────────────────────────────────
PE_BACKTEST_OUTPUT_DIR=<path-to-backtest-output-dir>     # [required] e.g. ./backtest-results

# ── Backtest tuning (optional — defaults in _GLOSSARY.md) ───────────────────────────────
# PE_BACKTEST_ACTIVE_MIN_CLOSED=15
# PE_BACKTEST_ACTIVE_MIN_MARKETS=5
# PE_BACKTEST_INCUBATOR_MIN_CLOSED=5
# PE_BACKTEST_INCUBATOR_MIN_MARKETS=2
# PE_BACKTEST_AUDIT_WINDOW_DAYS=180
# PE_BACKTEST_KELLY_P_PRIOR_ALPHA=2.0
# PE_BACKTEST_KELLY_P_PRIOR_BETA=1.0
# PE_BACKTEST_KELLY_P_K_PER_MARKET=6
# PE_BACKTEST_MAX_HOURS_TO_EXPIRY=
# PE_BACKTEST_MIN_QUALITY=0
# PE_BACKTEST_PER_TRADE_CAP=
# PE_BACKTEST_STEP_DAYS=1
# PE_BANKROLL_USD=10000
# PE_BACKTEST_KELLY_SWEEP=

# ── API base URLs (optional — defaults use production endpoints) ─────────────────────────
# PE_POLYMARKET_BASE_URL=https://clob.polymarket.com
# PE_POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
# PE_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# ── Logging ─────────────────────────────────────────────────────────────────────────────
RUST_LOG=info                                            # e.g. info, debug, pe_bootstrap=debug
